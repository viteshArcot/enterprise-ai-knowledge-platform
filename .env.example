# =============================================================================
# Enterprise AI Knowledge Platform — Environment Variables
# =============================================================================
# USAGE:
#   cp .env.example .env
#   Then fill in all values marked as REQUIRED.
#
# SECURITY:
#   .env is listed in .gitignore and must NEVER be committed to version control.
#   Use a secrets manager (AWS Secrets Manager, GCP Secret Manager, Vault)
#   for production deployments.
# =============================================================================


# =============================================================================
# Application
# =============================================================================

# Deployment environment. Controls log format, docs visibility, feature flags.
# Values: development | staging | production
ENVIRONMENT=development

# Enable verbose Python error tracebacks in HTTP error responses.
# Set to false in all non-development environments.
DEBUG=false


# =============================================================================
# Security
# =============================================================================

# REQUIRED: Strong random secret key for token signing and CSRF protection.
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long.
SECRET_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32

# Comma-separated list of allowed origins for CORS requests.
# In production, restrict to your frontend domain only.
# Example: https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# Database — PostgreSQL
# =============================================================================

# PostgreSQL superuser credentials (for local Docker development).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_platform

# Full async connection string used by the FastAPI backend (SQLAlchemy + asyncpg).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# Docker Compose: host is the service name (db), not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_platform

# SQLAlchemy connection pool: persistent connections kept open per process.
# Recommended: (db_max_connections / num_app_instances) - 2
DATABASE_POOL_SIZE=10

# Additional connections allowed when the pool is exhausted.
DATABASE_MAX_OVERFLOW=20

# Seconds to wait for a free connection before raising a timeout.
DATABASE_POOL_TIMEOUT=30

# Log all SQL queries to stdout. ONLY enable in development.
# WARNING: Produces extremely verbose output and may leak sensitive data.
DATABASE_ECHO=false


# =============================================================================
# Logging
# =============================================================================

# Minimum log level to emit.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format.
#   json    — Structured JSON for log aggregation systems
#   console — Human-readable colored output for local development.
LOG_FORMAT=console

# =============================================================================
# Ports (Docker Compose Development Only)
# =============================================================================

BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# =============================================================================
# LLM Providers
# =============================================================================

# Supported providers: gemini, openrouter, ollama
LLM_PROVIDER=gemini

# Gemini API Key (Required for embeddings and gemini chat provider)
# GEMINI_API_KEY=AIzaSy...

# OpenRouter Configuration
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4.1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Configuration
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Supabase Storage
# =============================================================================
# Used for persistent document PDF storage.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=enterprise-documents


# =============================================================================
# Frontend Configuration (Vercel / Build-time)
# =============================================================================
# NOTE: VITE_ variables are baked into the frontend bundle. Do NOT put secrets here.

# The public URL of the backend API.
# Development: can be empty (uses Vite proxy) or http://localhost:8000
# Production: https://your-backend-app.onrender.com
VITE_API_URL=http://localhost:8000
