# =============================================================================
# Enterprise AI Knowledge Platform — .gitignore
# =============================================================================

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / packaging
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
coverage/
*.cover
*.py,cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Ruff
.ruff_cache/

# =============================================================================
# Node / JavaScript / TypeScript
# =============================================================================
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Vite
.vite/

# =============================================================================
# Environment variables
# =============================================================================
# CRITICAL: Never commit .env files. They contain secrets.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example (it's the template — no secrets inside)
!.env.example

# =============================================================================
# Docker
# =============================================================================
docker-compose.override.yml
.docker/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
log/

# =============================================================================
# Database
# =============================================================================
*.sqlite3
*.db
*.sql.bak

# =============================================================================
# IDE and editor files
# =============================================================================

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim/Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.emacs.d/

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
# Operating system files
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~

# =============================================================================
# CI / CD artifacts
# =============================================================================
.cache/

# =============================================================================
# Temporary files
# =============================================================================
*.tmp
*.temp
tmp/
temp/

# Phase 2 local document storage
backend/uploads/*
!backend/uploads/.gitkeep
